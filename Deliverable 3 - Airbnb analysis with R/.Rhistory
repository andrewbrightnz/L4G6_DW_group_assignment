# Save the Christchurch dataset as a CSV file
write_csv(chch_Oct25_to_Jun26, "Data/chch_Oct25_to_Jun26.csv")
# Save the Christchurch June 2026 dataset as a CSV file
write_csv(chch_june, "Data/chch_june.csv")
